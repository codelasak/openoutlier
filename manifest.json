{
  "manifest_version": 3,
  "name": "OpenOutlier – open-source Reels, TikTok & Reddit analytics",
  "short_name": "OpenOutlier",
  "version": "0.2.0",
  "description": "Spot the posts that beat an account’s median: sort Reels, TikTok and Reddit posts, find outliers and the best time to post. Free.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokcdn-eu.com/*",
    "https://*.tiktokv.com/*",
    "https://*.ibyteimg.com/*",
    "https://www.reddit.com/*",
    "https://*.redd.it/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OpenOutlier",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/extract.js",
        "src/metrics.js",
        "src/brand.js",
        "src/panel.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "src/metrics.js",
        "src/tiktok.js",
        "src/brand.js",
        "src/panel.js",
        "src/overlay.js",
        "src/tiktok-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.reddit.com/*"
      ],
      "js": [
        "src/metrics.js",
        "src/reddit.js",
        "src/brand.js",
        "src/panel.js",
        "src/reddit-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css",
        "fonts/*.woff2",
        "brand/v2/wordmark/openoutlier-inline-trail3-transparent.svg",
        "brand/v2/mark/openoutlier-mark.svg",
        "brand/v2/mark/openoutlier-mark-on-ink.svg"
      ],
      "matches": [
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://www.reddit.com/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
